{
  "name": "@repo/worktrees-studio-ds",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles": "./src/styles/global.css"
  },
  "scripts": {
    "start": "expo start --port 8085",
    "start:web": "bun start -c --web",
    "android": "expo start --android --port 8085",
    "ios": "expo start --ios --port 8085",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:sonar": "ENABLE_LOCAL_SONAR=true eslint .",
    "lint:sonar:fix": "ENABLE_LOCAL_SONAR=true eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "agents-heroui": "bunx heroui-cli@latest agents-md --native --output AGENTS_HEROUI.md",
    "package-updates": "bunx npm-check-updates -i --format group",
    "test": "jest --forceExit",
    "test:watch": "jest --watchAll",
    "test:changed": "jest --forceExit --changedSince=origin/main",
    "test:ci": "jest --ci --forceExit --maxWorkers=2"
  },
  "jest": {
    "preset": "jest-expo",
    "reporters": [
      "default",
      "<rootDir>/test/jest-progress-reporter.cjs"
    ],
    "setupFiles": [
      "./src/jest-setup.tsx"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(?:\\.bun/|\\.pnpm/)?(react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|heroui-native|uniwind|react-native-reanimated|react-native-gesture-handler|react-native-safe-area-context|react-native-screens|react-native-worklets|react-native-web|@expo/vector-icons|react-native-svg|react-native-qrcode-svg|react-native-view-shot|html-to-image|tailwindcss|tailwind-merge|tailwind-variants|react-native-keyboard-controller|react-native-teleport|recharts))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo-google-fonts/roboto": "^0.4.3",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "5.4.0",
    "@repo/ds-collab": "workspace:*",
    "@repo/worktrees-studio-shared-ids": "workspace:*",
    "date-fns": "^4.4.0",
    "expo": "~57.0.24",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.4",
    "firebase": "^12.19.0",
    "heroui-native": "^1.0.6",
    "html-to-image": "^1.11.13",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.82.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-teleport": "1.1.12",
    "react-native-view-shot": "5.1.0",
    "react-native-worklets": "0.10.1",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.10.0",
    "worktrees-studio-asset-cache": "workspace:*",
    "worktrees-studio-mmkv": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@babel/runtime": "7.29.7",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.17",
    "babel-preset-expo": "~57.0.12",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.1",
    "expo-modules-core": "~57.0.18",
    "expo-font": "~57.0.4",
    "globals": "^17.6.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.8",
    "react-devtools-core": "^7.0.1",
    "react-native-web": "^0.21.2",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
